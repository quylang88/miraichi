# Provider capture data — local raw payloads and manifests are gitignored;
# .gitkeep sentinels are explicitly unignored to preserve directory structure.
apps/api/data/providers/*/raw/**
apps/api/data/providers/*/manifests/**
apps/api/data/providers/*/reports/**
apps/api/data/providers/*/state/**
!apps/api/data/providers/*/raw/.gitkeep
!apps/api/data/providers/*/manifests/.gitkeep
!apps/api/data/providers/*/reports/.gitkeep

# Serving store and warehouse generated data
apps/api/data/api-football/**
apps/api/data/match-details/**
apps/api/data/match-detail-refresh/**
apps/api/data/serving/manifest.json
apps/api/data/serving/versions/**
apps/api/data/warehouse/versions/**
apps/api/data/warehouse/runs/**
!apps/api/data/serving/README.md
!apps/api/data/serving/.gitkeep
!apps/api/data/warehouse/.gitkeep
