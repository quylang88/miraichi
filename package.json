{
  "name": "miraichi",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@10.18.3",
  "description": "Miraichi monorepo scaffold",
  "scripts": {
    "dev": "pnpm --filter \"./apps/*\" --parallel run dev",
    "web": "pnpm run dev:web",
    "dev:web": "pnpm --filter web run dev",
    "start:web": "pnpm --filter web run start",
    "build": "pnpm run build:web-static",
    "build:web-static": "pnpm --filter web run build:static",
    "dev:api": "pnpm --filter api run dev",
    "start:hosted": "pnpm --filter api run start",
    "auth:hash-password": "tsx scripts/hash-owner-password.ts",
    "dev:worker": "pnpm --filter worker run dev",
    "dev:cloudflare": "pnpm --filter @miraichi/cloudflare-gateway run dev",
    "data:build:serving:matches": "tsx scripts/build-serving-match-store.ts",
    "data:validate:serving:matches": "tsx scripts/build-serving-match-store.ts --validate-only",
    "data:sync:serving:cloud": "tsx scripts/sync-serving-match-store-to-cloud.ts",
    "sportscore:contract:verify": "tsx scripts/sportscore-contract-drift.ts",
    "sportscore:source:review": "tsx scripts/sportscore-operations.ts review-source",
    "sportscore:status": "tsx scripts/sportscore-operations.ts status",
    "sportscore:smoke:prepare": "tsx scripts/sportscore-operations.ts prepare-smoke-root",
    "data:hydrate:season:batch": "tsx scripts/season-hydration-runtime.ts",
    "data:revalidate:season:current": "tsx scripts/season-hydration-runtime.ts --mode revalidate-current",
    "data:results:terminal:once": "tsx scripts/fotmob-terminal-results-runtime.ts --mode once",
    "data:results:terminal:watch": "tsx scripts/fotmob-terminal-results-runtime.ts --mode watch",
    "fotmob:terminal:integration": "pnpm exec vitest run apps/worker/src/sources/fotmob/fotmob-daily-client.test.ts apps/worker/src/sources/fotmob/fotmob-daily-adapter.test.ts apps/worker/src/sources/fotmob/fotmob-result-ledger.test.ts apps/worker/src/sources/fotmob/fotmob-terminal-plan.test.ts apps/worker/src/sources/shared/canonical-publication-job-lease.test.ts apps/worker/src/jobs/fotmob-terminal-result-job.test.ts scripts/fotmob-terminal-results-runtime.test.ts tests/integration/fotmob-terminal-results.test.ts",
    "hosted:integration": "pnpm exec vitest run tests/integration/hosted-owner-live-flow.test.ts",
    "edge-owner:integration": "pnpm exec vitest run tests/integration/supabase-edge-owner-flow.test.ts tests/integration/cloudflare-edge-owner-flow.test.ts",
    "sportscore:active:bootstrap": "tsx scripts/sportscore-operations.ts bootstrap-active-root",
    "sportscore:integration": "pnpm exec vitest run tests/integration/sportscore-source-boundary.test.ts scripts/sportscore-contract-drift.test.ts scripts/sportscore-operations.test.ts apps/api/src/routes/matches.test.ts && pnpm run sportscore:contract:verify",
    "live:hourly:verify": "tsx scripts/hourly-live-refresh-workflow.ts",
    "live:hourly:local-sql-smoke": "tsx scripts/hourly-live-refresh-workflow.ts --local-sql-smoke",
    "sportscore:attribution:verify": "tsx scripts/static-sportscore-attribution.ts",
    "season:integration": "pnpm exec vitest run packages/config/src/season-source-registry.test.ts apps/worker/src/sources/hydration/season-hydration-plan.test.ts apps/worker/src/sources/hydration/season-hydration-ledger.test.ts apps/worker/src/sources/openfootball/openfootball-client.test.ts apps/worker/src/sources/openfootball/openfootball-adapter.test.ts apps/worker/src/sources/fotmob/fotmob-season-client.test.ts apps/worker/src/sources/fotmob/fotmob-season-adapter.test.ts apps/worker/src/jobs/season-hydration-job.test.ts scripts/season-hydration-runtime.test.ts",
    "supabase:local:start": "supabase db start",
    "supabase:local:status": "tsx scripts/supabase-local-workflow.ts status",
    "supabase:local:sync": "tsx scripts/supabase-local-workflow.ts sync",
    "supabase:local:verify": "tsx scripts/supabase-local-workflow.ts verify",
    "edge:function:build": "tsx scripts/build-supabase-edge-function.ts",
    "edge:function:graph:verify": "tsx scripts/verify-supabase-edge-module-graph.ts",
    "edge:runtime:smoke": "tsx scripts/supabase-edge-runtime-smoke.ts",
    "cloudflare:deploy:dry-run": "pnpm --filter @miraichi/cloudflare-gateway run deploy:dry-run",
    "cloudflare:artifact:verify": "tsx scripts/cloudflare-owner-hosting-verify.ts",
    "phase9:local-data-api-verify": "pnpm exec vitest run packages/shared/src/contracts/local-match-contracts.test.ts apps/api/src/repositories/serving-match-store.test.ts apps/api/src/repositories/serving-match-store-repository.test.ts apps/api/src/routes/matches.test.ts apps/api/src/routes/match-detail.test.ts apps/api/src/routes/data-snapshot-status.test.ts apps/web/src/services/match-feed-service.test.ts apps/web/src/production-shell.test.ts scripts/build-serving-match-store.test.ts scripts/phase3-verify.test.ts",
    "phase9:cloud-persistence-verify": "tsx scripts/phase9-cloud-persistence-verify.ts",
    "phase9:non-ai-app-verify": "pnpm run phase9:local-data-api-verify && pnpm run phase9:cloud-persistence-verify",
    "check": "tsx scripts/check-files.ts",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --exclude \"tests/integration/**\" --maxWorkers=2",
    "test:unit:coverage": "vitest run --coverage",
    "lint": "tsx scripts/check-js-syntax.ts .",
    "verify:lifecycle": "tsx scripts/verify-lifecycle.ts",
    "test:integration": "pnpm run phase3:verify && pnpm run sportscore:integration && pnpm run season:integration && pnpm run fotmob:terminal:integration && pnpm run hosted:integration && pnpm run edge-owner:integration && pnpm run test:e2e && pnpm run pwa:verify",
    "verify:product-boundary": "tsx scripts/product-boundary-verify.ts",
    "verify:local": "pnpm run verify:product-boundary && pnpm run verify:lifecycle && pnpm run test:unit && pnpm run lint && pnpm run typecheck && pnpm run audit && pnpm run audit:type-safety",
    "verify:release": "pnpm run verify:local && pnpm run test:integration",
    "verify:staging": "pnpm run verify:release && pnpm run build:web-static",
    "smoke:staging": "tsx scripts/staging-smoke-check.ts",
    "test:e2e": "tsx scripts/test-endpoints.ts",
    "test:e2e:staging": "tsx tests/e2e/staging-owner-flow.ts",
    "verify:staging:hosted": "tsx scripts/verify-staging-hosted.ts",
    "provider:local-sql-smoke": "tsx scripts/hosted-provider-local-sql-smoke.ts",
    "audit": "tsx scripts/audit-rules.ts",
    "audit:type-safety": "tsx scripts/type-safety-audit.ts",
    "phase2:check-rules": "tsx scripts/phase2-verify.ts",
    "phase2:verify": "pnpm run check && pnpm run audit && pnpm run phase2:check-rules && pnpm run test:e2e",
    "phase3:verify": "tsx scripts/phase3-verify.ts",
    "pwa:verify": "tsx scripts/pwa-verify.ts",
    "typecheck": "tsc -p tsconfig.base.json --noEmit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "playwright": "1.58.2",
    "supabase": "2.109.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
