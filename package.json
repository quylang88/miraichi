{
  "name": "miraichi",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Miraichi monorepo scaffold",
  "scripts": {
    "dev": "pnpm --filter \"./apps/*\" --parallel run dev",
    "dev:web": "pnpm --filter web run dev",
    "start:web": "pnpm --filter web run start",
    "build:web-static": "pnpm --filter web run build:static",
    "dev:api": "pnpm --filter api run dev",
    "dev:local-ai": "pnpm --filter local-ai run dev",
    "dev:worker": "pnpm --filter worker run dev",
    "check": "node scripts/check-files.js",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "lint": "node scripts/check-js-syntax.js .",
    "verify:lifecycle": "node scripts/verify-lifecycle.js",
    "test:integration": "pnpm run phase3:verify && pnpm run phase4:verify && pnpm run phase4:integration && pnpm run test:e2e && pnpm run pwa:verify",
    "verify:local": "pnpm run verify:lifecycle && pnpm run test:unit && pnpm run lint && pnpm run typecheck && pnpm run audit",
    "verify:release": "pnpm run verify:local && pnpm run test:integration",
    "test:e2e": "node scripts/test-endpoints.js",
    "audit": "node scripts/audit-rules.js",
    "phase2:check-rules": "node scripts/phase2-verify.js",
    "phase2:verify": "pnpm run check && pnpm run audit && pnpm run phase2:check-rules && pnpm run test:e2e",
    "phase3:verify": "node scripts/phase3-verify.js",
    "phase4:verify": "node scripts/phase4-verify.js",
    "phase4:integration": "node scripts/phase4-integration-verify.js",
    "pwa:verify": "node scripts/pwa-verify.js",
    "typecheck": "tsc -p tsconfig.base.json --noEmit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "fake-indexeddb": "6.2.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
