{
  "name": "miraichi",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Miraichi monorepo scaffold",
  "scripts": {
    "dev": "pnpm --filter \"./apps/*\" --parallel run dev",
    "web": "pnpm run dev:web",
    "dev:web": "pnpm --filter web run dev",
    "start:web": "pnpm --filter web run start",
    "build": "pnpm run build:web-static",
    "build:web-static": "pnpm --filter web run build:static",
    "dev:api": "pnpm --filter api run dev",
    "dev:local-ai": "pnpm --filter local-ai run dev",
    "dev:worker": "pnpm --filter worker run dev",
    "data:build:serving:matches": "tsx scripts/build-serving-match-store.ts",
    "data:validate:serving:matches": "tsx scripts/build-serving-match-store.ts --validate-only",
    "data:sync:serving:cloud": "tsx scripts/sync-serving-match-store-to-cloud.ts",
    "supabase:local:start": "supabase db start",
    "supabase:local:status": "tsx scripts/supabase-local-workflow.ts status",
    "supabase:local:sync": "tsx scripts/supabase-local-workflow.ts sync",
    "supabase:local:verify": "tsx scripts/supabase-local-workflow.ts verify",
    "phase9:local-data-api-verify": "pnpm exec vitest run packages/shared/src/contracts/local-match-contracts.test.ts apps/api/src/repositories/serving-match-store.test.ts apps/api/src/repositories/serving-match-store-repository.test.ts apps/api/src/routes/matches.test.ts apps/api/src/routes/match-detail.test.ts apps/api/src/routes/data-snapshot-status.test.ts apps/web/src/services/match-feed-service.test.ts apps/web/src/production-shell.test.ts scripts/build-serving-match-store.test.ts scripts/phase3-verify.test.ts",
    "phase9:cloud-persistence-verify": "tsx scripts/phase9-cloud-persistence-verify.ts",
    "phase9:non-ai-app-verify": "pnpm run phase9:local-data-api-verify && pnpm run phase9:cloud-persistence-verify",
    "check": "tsx scripts/check-files.ts",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "lint": "tsx scripts/check-js-syntax.ts .",
    "verify:lifecycle": "tsx scripts/verify-lifecycle.ts",
    "test:integration": "pnpm run phase3:verify && pnpm run phase4:verify && pnpm run phase4:integration && pnpm run test:e2e && pnpm run pwa:verify",
    "verify:local": "pnpm run verify:lifecycle && pnpm run test:unit && pnpm run lint && pnpm run typecheck && pnpm run audit && pnpm run audit:type-safety",
    "verify:release": "pnpm run verify:local && pnpm run test:integration",
    "verify:staging": "pnpm run verify:release && pnpm run build:web-static",
    "deploy:staging": "pnpm run verify:staging && pnpm dlx wrangler pages deploy apps/web/dist --project-name miraichi-staging",
    "deploy:staging:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-staging-local.ps1",
    "smoke:staging": "tsx scripts/staging-smoke-check.ts",
    "test:e2e": "tsx scripts/test-endpoints.ts",
    "audit": "tsx scripts/audit-rules.ts",
    "audit:type-safety": "tsx scripts/type-safety-audit.ts",
    "phase2:check-rules": "tsx scripts/phase2-verify.ts",
    "phase2:verify": "pnpm run check && pnpm run audit && pnpm run phase2:check-rules && pnpm run test:e2e",
    "phase3:verify": "tsx scripts/phase3-verify.ts",
    "phase4:verify": "tsx scripts/phase4-verify.ts",
    "phase4:integration": "tsx scripts/phase4-integration-verify.ts",
    "phase8:feature-audit": "tsx scripts/phase8-feature-leakage-verify.ts",
    "phase8:evaluation-harness": "tsx scripts/phase8-evaluation-harness-verify.ts",
    "phase8:national-team-expansion": "tsx scripts/phase8-national-team-expansion-verify.ts",
    "phase8:candidate-bakeoff": "tsx scripts/phase8-candidate-bakeoff-verify.ts",
    "phase8:experimental-report-surface": "tsx scripts/phase8-experimental-report-surface-verify.ts",
    "phase8:sofascore-national-team-discovery": "tsx scripts/phase8-sofascore-national-team-discovery-verify.ts",
    "phase8:sofascore-national-team-ingestion": "tsx scripts/phase8-sofascore-national-team-ingestion-verify.ts",
    "pwa:verify": "tsx scripts/pwa-verify.ts",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "data:capture:sportmonks": "tsx scripts/capture-sportmonks-trial-data.ts",
    "data:capture:sportmonks:season-scope": "tsx scripts/capture-sportmonks-season-scoped-data.ts",
    "data:capture:sportmonks:expected": "tsx scripts/capture-sportmonks-expected-data.ts",
    "data:capture:sportmonks:league": "tsx scripts/capture-sportmonks-league-data.ts",
    "data:probe:sportmonks": "tsx scripts/probe-sportmonks-fixture-enrichment.ts",
    "data:enrich:sportmonks:fixtures": "tsx scripts/enrich-sportmonks-fixtures.ts",
    "data:normalize:sportmonks:warehouse": "tsx scripts/providers/sportmonks/normalize-to-warehouse.ts",
    "data:verify:sportmonks": "tsx scripts/providers/sportmonks/verify-capture.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "fake-indexeddb": "6.2.5",
    "supabase": "2.109.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
