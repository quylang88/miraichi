# Miraichi Environment Variables Template
# Copy this file to .env and fill in the values. Do not commit actual secrets.

# Application Configuration
APP_ENV=local
APP_NAME=Miraichi
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
LOCAL_AI_URL=http://localhost:8000
LOG_LEVEL=info

# Database and Cache Connections
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/miraichi?schema=public
REDIS_URL=redis://localhost:6379

# LLM Orchestration
LLM_PROVIDER=openai
LLM_API_KEY=

# Football Data Provider
DATA_PROVIDER=sportmonks
DATA_PROVIDER_API_KEY=

# Cloudflare Pages Staging Deployment
# Do not commit real token values. Set these outside the repo before staging deploy.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PAGES_PROJECT=miraichi-staging
