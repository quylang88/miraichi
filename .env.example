# Miraichi Environment Variables Template
# Copy this file to .env for local configuration and secrets. Do not commit actual secrets.

# Application Configuration
APP_ENV=local
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Hosted one-origin runtime. Koyeb sets PORT; API_URL may be omitted there.
HOSTED_WEB_MODE=disabled
HOSTED_WEB_ROOT=apps/web/dist

# Owner-only hosted access. Non-local environments require password mode.
MIRAICHI_OWNER_AUTH_MODE=disabled
MIRAICHI_OWNER_PASSWORD_HASH=
MIRAICHI_SESSION_SECRET=
MIRAICHI_SESSION_TTL_SECONDS=604800

# SportScore free widget API only. Never configure a /api/v1 endpoint.
SPORTSCORE_LIVE_MODE=disabled
SPORTSCORE_WIDGET_TIMEOUT_MS=8000
# Separate service credential for the exact POST hourly live refresh route (minimum 32 bytes).
MIRAICHI_REFRESH_TOKEN=

# Cloud Persistence (Supabase PostgreSQL / Cloud Sync)
# For local Supabase Docker DB, use: postgresql://postgres:postgres@127.0.0.1:54322/postgres
CLOUD_PERSISTENCE_MODE=disabled
SUPABASE_DATABASE_URL=
# Base64 of the project-specific PEM certificate downloaded from Supabase Database Settings.
SUPABASE_DATABASE_CA_BASE64=
MIRAICHI_OWNER_PROFILE_ID=owner-primary

# Local Serving Store & Provider Data Paths (relative to workspace root)
LOCAL_MATCH_SERVING_ROOT=apps/api/data/serving
PROVIDER_CAPTURE_ROOT=apps/api/data
