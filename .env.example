# Miraichi Environment Variables Template
# Copy this file to .env for local-only secrets. Do not commit actual secrets.
# For Cloudflare Pages staging, fill CLOUDFLARE_API_TOKEN in .env and run:
# pnpm run deploy:staging:local

# Application Configuration
APP_ENV=local
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Phase 9 owner-only cloud persistence. Keep this URL server-side.
# For local Supabase Docker DB, use:
# SUPABASE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
CLOUD_PERSISTENCE_MODE=disabled
SUPABASE_DATABASE_URL=
MIRAICHI_OWNER_PROFILE_ID=owner-primary

# Cloudflare Pages Staging Deployment
# Do not commit real token values. Set these outside the repo before staging deploy.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PAGES_PROJECT=miraichi-staging

# Local match snapshot. Default path is resolved from workspace root.
LOCAL_MATCH_SNAPSHOT_PATH=apps/api/data/local-match-snapshots/national-team-matches.json
